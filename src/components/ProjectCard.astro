---
import PhoneFrame from "./PhoneFrame.astro";
import { projectImage } from "../lib/images";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const cover = project.images[0];
const img = projectImage(project.slug, cover.file);
const href = `/projects/${project.slug}/`;
---

<a
  href={href}
  class:list={["pcard", { "pcard--featured": project.featured }]}
  style={`--tint:${project.tint}`}
  data-category={project.category}
  data-cursor
  aria-label={`${project.name} — ${project.tagline}`}
>
  <div class="pcard__media" transition:name={`cover-${project.slug}`}>
    <PhoneFrame src={img} alt={cover.alt} width={project.featured ? 340 : 280} />
  </div>

  <div class="pcard__body">
    <div class="pcard__head">
      <span class="pcard__name">{project.name}</span>
      <span class="pcard__arrow" aria-hidden="true">↗</span>
    </div>
    <p class="pcard__tagline">{project.tagline}</p>
    <div class="pcard__meta">
      <span class="chip pcard__chip">{project.stack}</span>
      <span class="chip">{project.category}</span>
    </div>
    <span class="pcard__explore">Explore project <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.4rem 1.6rem;
    border-radius: var(--radius-card);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
    overflow: hidden;
    transition: transform 0.5s var(--ease-out-expo), border-color 0.4s, box-shadow 0.5s;
    will-change: transform;
  }
  /* tint wash */
  .pcard::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 50% -10%, color-mix(in srgb, var(--tint) 26%, transparent), transparent 60%);
    opacity: 0.6;
    transition: opacity 0.5s;
    pointer-events: none;
  }
  .pcard:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--tint) 45%, var(--color-line));
    box-shadow: 0 30px 60px -28px color-mix(in srgb, var(--tint) 55%, black);
  }
  .pcard:hover::before {
    opacity: 1;
  }
  .pcard:hover :global(.phone__screen img) {
    transform: translateY(-7%) scale(1.04);
  }

  .pcard__media {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: 0.5rem 1.4rem;
  }
  .pcard__media :global(.phone) {
    width: min(58%, 220px);
  }

  .pcard__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .pcard__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .pcard__arrow {
    color: var(--color-ink-faint);
    transition: transform 0.4s var(--ease-out-expo), color 0.4s;
  }
  .pcard:hover .pcard__arrow {
    transform: translate(3px, -3px);
    color: var(--tint);
  }
  .pcard__tagline {
    margin-top: 0.4rem;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .pcard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .pcard__chip {
    border-color: color-mix(in srgb, var(--tint) 40%, var(--color-line));
    color: var(--color-ink);
  }
  .pcard__explore {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.2rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .pcard__explore span {
    transition: transform 0.4s var(--ease-out-expo);
  }
  .pcard:hover .pcard__explore {
    color: var(--color-ink);
  }
  .pcard:hover .pcard__explore span {
    transform: translateX(4px);
  }

  /* Featured cards: wider media, span 2 cols on desktop */
  @media (min-width: 900px) {
    .pcard--featured {
      grid-column: span 2;
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
      padding: 2rem;
    }
    .pcard--featured .pcard__media {
      flex: 0 0 42%;
      padding: 0;
    }
    .pcard--featured .pcard__media :global(.phone) {
      width: min(70%, 260px);
    }
    .pcard--featured .pcard__body {
      flex: 1;
    }
    .pcard--featured .pcard__name {
      font-size: 1.9rem;
    }
    .pcard--featured .pcard__tagline {
      font-size: 1.05rem;
      max-width: 34ch;
    }
  }
</style>

---
import Media from "./Media.astro";
import { projectImage } from "../lib/images";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const cover = project.images[0];
const img = projectImage(project.slug, cover.file);
const href = `/projects/${project.slug}/`;
---

<a
  href={href}
  class="pcard reveal"
  style={`--tint:${project.tint}`}
  data-category={project.category}
  data-cursor
  aria-label={`${project.name} — ${project.tagline}`}
>
  <div class="pcard__media" transition:name={`cover-${project.slug}`}>
    <Media src={img} alt={cover.alt} class="pcard__img" />
  </div>

  <div class="pcard__foot">
    <div class="pcard__row">
      <h3 class="pcard__name">{project.name}</h3>
      <span class="pcard__arrow" aria-hidden="true">↗</span>
    </div>
    <p class="pcard__tagline">{project.tagline}</p>
    <div class="pcard__meta">
      <span class="pcard__tag">{project.stack}</span>
      <span class="pcard__dot" aria-hidden="true">·</span>
      <span class="pcard__tag">{project.category}</span>
    </div>
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .pcard__media {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 14px;
    background: color-mix(in srgb, var(--tint) 9%, #e7e6e3);
    border: 1px solid var(--color-line);
    transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s;
  }
  .pcard:hover .pcard__media {
    transform: translateY(-6px);
    box-shadow: 0 26px 50px -26px color-mix(in srgb, var(--tint) 60%, black);
  }
  .pcard__media :global(.pcard__img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .pcard__foot {
    padding: 1rem 0.2rem 0;
  }
  .pcard__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .pcard__name {
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .pcard__arrow {
    color: var(--color-ink-faint);
    transition: transform 0.4s var(--ease-out-expo), color 0.4s;
  }
  .pcard:hover .pcard__arrow {
    transform: translate(3px, -3px);
    color: var(--color-ink);
  }
  .pcard__tagline {
    margin-top: 0.3rem;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .pcard__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.7rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .pcard__dot {
    opacity: 0.6;
  }
</style>

---
import { person, metrics, clients } from "../../data/profile";
---

<section class="hero" id="intro" aria-labelledby="hero-title">
  <div class="container-page hero__inner">
    <p class="eyebrow reveal">{person.role} · {person.location} · {person.years} years</p>

    <h1 id="hero-title" class="hero__title reveal">{person.name}</h1>

    <p class="hero__lead reveal">
      I build and lead secure, high-scale <strong>Android</strong> &amp;
      <strong>React Native</strong> apps for fintech and digital banking — from
      digital onboarding and NFC payments to modular architecture, atomic design
      systems, and AI-accelerated delivery.
    </p>

    <div class="hero__cta reveal">
      <a href="/#work" class="btn btn-primary">View work</a>

      <a href={person.cv} target="_blank" rel="noopener" class="btn btn-ghost">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" />
        </svg>
        Résumé
      </a>

      <span class="hero__social">
        <a href={person.linkedin} target="_blank" rel="noopener" class="hero__icon" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 18.34V9.9H5.67v8.44h2.67zM7 8.67a1.55 1.55 0 1 0 0-3.1 1.55 1.55 0 0 0 0 3.1zm11.34 9.67v-4.63c0-2.47-1.32-3.62-3.08-3.62-1.42 0-2.06.78-2.41 1.33v-1.14h-2.67c.04.75 0 8.44 0 8.44h2.67v-4.71c0-.24.02-.48.09-.65.19-.48.63-.98 1.36-.98.96 0 1.35.73 1.35 1.8v4.54h2.67z" />
          </svg>
        </a>
        <a href={person.github} target="_blank" rel="noopener" class="hero__icon" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
          </svg>
        </a>
      </span>
    </div>

    <dl class="hero__stats">
      {
        metrics.map((m) => (
          <div class="hero__stat reveal">
            <dt class="hero__stat-value" data-countup>{m.value}</dt>
            <dd class="hero__stat-label">{m.label}</dd>
          </div>
        ))
      }
    </dl>

    <p class="hero__clients reveal">
      <span>Worked with</span> {clients.join("  ·  ")}
    </p>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 8rem 4rem;
  }
  .hero__title {
    margin-top: 1.4rem;
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .hero__lead {
    max-width: 46rem;
    margin-top: 1.8rem;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.4;
    color: var(--color-ink-soft);
  }
  .hero__lead strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
    margin-top: 2.4rem;
  }
  .hero__social {
    display: inline-flex;
    gap: 0.6rem;
    margin-left: 0.4rem;
  }
  .hero__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    color: var(--color-ink);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s, transform 0.3s var(--ease-out-expo);
  }
  .hero__icon:hover {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
    margin: 4rem 0 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .hero__stat-label {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
  }

  .hero__clients {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }
  .hero__clients span {
    color: var(--color-ink);
    font-weight: 600;
    margin-right: 0.4rem;
  }

  @media (min-width: 780px) {
    .hero__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

---
import { person, metrics, clients } from "../../data/profile";
---

<section class="hero" id="intro" aria-labelledby="hero-title">
  <div class="container-page hero__inner">
    <p class="eyebrow reveal">{person.role} · {person.location} · {person.years} years</p>

    <h1 id="hero-title" class="hero__title reveal">{person.name}</h1>

    <p class="hero__lead reveal">
      I build and lead secure, high-scale <strong>Android</strong> &amp;
      <strong>React Native</strong> apps for fintech and digital banking — from
      digital onboarding and NFC payments to modular architecture, atomic design
      systems, and AI-accelerated delivery.
    </p>

    <div class="hero__cta reveal">
      <a href="/#work" class="btn btn-primary">View work</a>
      <a href="/#contact" class="btn btn-ghost">Get in touch</a>
      <a href={person.linkedin} target="_blank" rel="noopener" class="hero__link">LinkedIn ↗</a>
    </div>

    <dl class="hero__stats">
      {
        metrics.map((m) => (
          <div class="hero__stat reveal">
            <dt class="hero__stat-value" data-countup>{m.value}</dt>
            <dd class="hero__stat-label">{m.label}</dd>
          </div>
        ))
      }
    </dl>

    <p class="hero__clients reveal">
      <span>Worked with</span> {clients.join("  ·  ")}
    </p>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 8rem 4rem;
  }
  .hero__title {
    margin-top: 1.4rem;
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .hero__lead {
    max-width: 46rem;
    margin-top: 1.8rem;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.4;
    color: var(--color-ink-soft);
  }
  .hero__lead strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
    margin-top: 2.4rem;
  }
  .hero__link {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    transition: color 0.3s;
  }
  .hero__link:hover {
    color: var(--color-ink);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
    margin: 4rem 0 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .hero__stat-label {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
  }

  .hero__clients {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }
  .hero__clients span {
    color: var(--color-ink);
    font-weight: 600;
    margin-right: 0.4rem;
  }

  @media (min-width: 780px) {
    .hero__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

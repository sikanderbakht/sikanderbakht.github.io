---
import { skillGroups } from "../../data/profile";
---

<section class="skills" id="skills" aria-labelledby="skills-title">
  <div class="container-page">
    <div class="skills__head reveal">
      <p class="eyebrow">Toolkit</p>
      <h2 id="skills-title" class="skills__title">Skills &amp; stack</h2>
      <p class="skills__intro">
        Primarily <strong>Android</strong> and <strong>React Native</strong> — with
        iOS, Flutter and Kotlin Multiplatform in the toolkit — plus the
        architecture, testing and AI-assisted workflow to ship them reliably.
      </p>
    </div>

    <dl class="skills__rows">
      {
        skillGroups.map((g) => (
          <div class="skills__row reveal">
            <dt class="skills__cat">{g.title}</dt>
            <dd class="skills__items">
              {g.items.map((s) => (
                <span class="skills__tag">{s}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills {
    padding-block: clamp(3.5rem, 8vw, 7rem);
    scroll-margin-top: 80px;
  }
  .skills__head {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .skills__title {
    margin-top: 0.9rem;
    font-size: var(--text-display);
  }
  .skills__intro {
    margin-top: 1.2rem;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .skills__intro strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .skills__rows {
    margin: 0;
    border-top: 1px solid var(--color-line);
  }
  .skills__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    padding-block: clamp(1.4rem, 3vw, 2rem);
    border-bottom: 1px solid var(--color-line);
  }
  .skills__cat {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .skills__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .skills__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-bg-raised);
    font-size: 0.85rem;
    color: var(--color-ink);
    transition: border-color 0.3s, transform 0.3s var(--ease-out-expo);
  }
  .skills__tag:hover {
    border-color: var(--color-ink);
  }

  @media (min-width: 780px) {
    .skills__row {
      grid-template-columns: 15rem 1fr;
      gap: 2.5rem;
      align-items: baseline;
    }
  }
</style>

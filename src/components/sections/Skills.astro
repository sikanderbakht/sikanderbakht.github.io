---
import { skillGroups } from "../../data/profile";
---

<section class="skills" id="skills" aria-labelledby="skills-title">
  <div class="container-page">
    <div class="skills__head reveal">
      <p class="eyebrow">Toolkit</p>
      <h2 id="skills-title" class="skills__title">Skills &amp; stack</h2>
    </div>

    <div class="skills__grid">
      {
        skillGroups.map((g) => (
          <div class="skills__group reveal">
            <h3 class="skills__group-title">{g.title}</h3>
            <ul class="skills__chips">
              {g.items.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    padding-block: clamp(3rem, 7vw, 6rem);
    scroll-margin-top: 80px;
  }
  .skills__head {
    margin-bottom: 2.5rem;
  }
  .skills__title {
    margin-top: 0.9rem;
    font-size: var(--text-display);
  }
  .skills__grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr;
  }
  .skills__group-title {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-bottom: 1rem;
  }
  .skills__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 720px) {
    .skills__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1080px) {
    .skills__grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>

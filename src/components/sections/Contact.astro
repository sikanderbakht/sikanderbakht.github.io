---
import { person } from "../../data/profile";
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container-page contact__inner">
    <p class="eyebrow reveal">Contact</p>

    <h2 id="contact-title" class="contact__title reveal">
      Have a hard mobile<br />problem? <em class="serif">Let's talk.</em>
    </h2>

    <a class="contact__email reveal" href={`mailto:${person.email}`}>
      {person.email}
    </a>

    <p class="contact__avail reveal">
      Open to Mobile Lead roles &amp; select consulting · Based in {person.location} (GST) ·
      Usually replies within a day.
    </p>

    <div class="contact__links reveal">
      <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
      <a href={person.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      <a href={`tel:${person.phoneHref}`}>{person.phone}</a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(2rem, 5vw, 4rem);
  }
  .contact__title {
    margin-top: 1.2rem;
    font-size: var(--text-display);
    line-height: 1.02;
  }
  .contact__email {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.4rem, 1rem + 2.6vw, 3rem);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    background-image: linear-gradient(var(--color-ink), var(--color-ink));
    background-size: 0% 1.5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s var(--ease-out-expo);
  }
  .contact__email:hover {
    background-size: 100% 1.5px;
  }
  .contact__avail {
    max-width: 52ch;
    margin-top: 1.6rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .contact__links a {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    transition: color 0.3s;
  }
  .contact__links a:hover {
    color: var(--color-ink);
  }
</style>

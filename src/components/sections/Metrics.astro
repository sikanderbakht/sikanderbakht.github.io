---
import { metrics } from "../../data/profile";
// card style rotates: light → contrast(dark) → light → contrast
const styles = ["light", "contrast", "light", "contrast"];
---

<section class="facts" data-theme="light" aria-labelledby="facts-title">
  <div class="container-page">
    <header class="facts__head reveal">
      <h2 id="facts-title" class="facts__title">Key facts</h2>
      <p class="facts__sub">A snapshot of<br />experience and impact.</p>
    </header>

    <dl class="facts__grid">
      {
        metrics.map((m, i) => (
          <div class:list={["facts__card", `facts__card--${styles[i % styles.length]}`, "reveal"]}>
            <dt class="facts__value" data-countup>{m.value}</dt>
            <dd class="facts__label">{m.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .facts {
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }
  .facts__head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .facts__title {
    font-size: var(--text-display);
  }
  .facts__sub {
    margin-top: 0.8rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }
  .facts__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0;
  }
  .facts__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(200px, 30vw, 320px);
    padding: 1.6rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
  }
  .facts__card--light {
    background: var(--color-bg-raised);
  }
  .facts__card--contrast {
    background: var(--color-bg-contrast);
    color: var(--color-ink-on-contrast);
    border-color: transparent;
  }
  .facts__value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    align-self: flex-end;
    order: 2;
  }
  .facts__label {
    order: 1;
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.75;
    max-width: 20ch;
  }
  @media (min-width: 900px) {
    .facts__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

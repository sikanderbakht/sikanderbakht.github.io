---
import { Image } from "astro:assets";
import { isVector } from "../lib/images";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** eager-load the first visible frame for LCP */
  eager?: boolean;
  /** CSS pixel width the frame renders at (for srcset sizing) */
  width?: number;
  class?: string;
}

const { src, alt, eager = false, width = 320, class: className = "" } = Astro.props;
const vector = isVector(src);
---

<div class={`phone ${className}`}>
  <div class="phone__frame">
    <div class="phone__notch"></div>
    <div class="phone__screen">
      {
        vector ? (
          <img src={src.src} alt={alt} width={src.width} height={src.height} loading={eager ? "eager" : "lazy"} decoding="async" />
        ) : (
          <Image
            src={src}
            alt={alt}
            widths={[320, 480, 720, src.width]}
            sizes={`${width}px`}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
            {...(eager ? { fetchpriority: "high" } : {})}
          />
        )
      }
    </div>
  </div>
</div>

<style>
  .phone {
    --bezel: 10px;
    --radius: 40px;
    width: 100%;
    aspect-ratio: 9 / 19.5;
  }
  .phone__frame {
    position: relative;
    width: 100%;
    height: 100%;
    padding: var(--bezel);
    border-radius: var(--radius);
    background: linear-gradient(150deg, #26262c, #0e0e12 55%, #1a1a1f);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.08),
      inset 0 0 0 3px rgba(0, 0, 0, 0.6),
      0 40px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--radius) - var(--bezel));
    background: #000;
  }
  .phone__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    /* subtle pan revealed on card hover (set by parent) */
    transition: transform 0.7s var(--ease-out-expo);
  }
  .phone__notch {
    position: absolute;
    top: calc(var(--bezel) + 6px);
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 18px;
    border-radius: 999px;
    background: #050506;
    z-index: 2;
  }
</style>

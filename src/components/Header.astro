---
const links = [
  { href: "/#work", label: "Work" },
  { href: "/#experience", label: "Experience" },
  { href: "/#skills", label: "Skills" },
];
---

<header class="site-header">
  <div class="container-page site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Sikander Bakht — home">
      <span class="site-header__mark" aria-hidden="true">◇</span>
      <span class="site-header__name">SIKANDER BAKHT</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a href="/#contact" class="site-header__cta">Let's talk</a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 72px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
  }
  .site-header__mark {
    font-size: 1rem;
  }
  .site-header__nav {
    display: none;
    gap: 2rem;
    margin-left: auto;
    margin-right: 1.75rem;
  }
  .site-header__nav a {
    position: relative;
    font-size: 0.9rem;
    opacity: 0.85;
    transition: opacity 0.3s;
  }
  .site-header__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.35s var(--ease-out-expo);
  }
  .site-header__nav a:hover {
    opacity: 1;
  }
  .site-header__nav a:hover::after {
    width: 100%;
  }
  .site-header__cta {
    display: none;
    padding: 0.55rem 1.1rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    transition: opacity 0.3s;
  }
  .site-header__cta:hover {
    opacity: 0.7;
  }
  @media (min-width: 820px) {
    .site-header__nav,
    .site-header__cta {
      display: inline-flex;
    }
  }
  @media (max-width: 819px) {
    .site-header__name {
      font-size: 0.78rem;
    }
  }
</style>

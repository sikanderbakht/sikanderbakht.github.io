---
import { person } from "../data/profile";
const year = new Date().getFullYear();

const navigate = [
  { href: "/#work", label: "Work" },
  { href: "/#experience", label: "Experience" },
  { href: "/#skills", label: "Skills" },
  { href: "/#contact", label: "Contact" },
];
const connect = [
  { href: person.linkedin, label: "LinkedIn", ext: true },
  { href: person.github, label: "GitHub", ext: true },
  { href: person.cv, label: "Résumé", ext: true },
  { href: `mailto:${person.email}`, label: "Email", ext: false },
];
---

<footer class="site-footer">
  <div class="container-page">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/#intro" class="site-footer__name">Sikander Bakht</a>
        <p class="site-footer__blurb">
          Mobile Lead building secure, high-scale Android &amp; React Native apps
          for fintech and digital banking.
        </p>
      </div>

      <nav class="site-footer__cols" aria-label="Footer">
        <div class="site-footer__col">
          <h2>Navigate</h2>
          {navigate.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
        <div class="site-footer__col">
          <h2>Connect</h2>
          {
            connect.map((l) => (
              <a href={l.href} target={l.ext ? "_blank" : undefined} rel={l.ext ? "noopener" : undefined}>
                {l.label}
              </a>
            ))
          }
        </div>
      </nav>
    </div>

    <div class="site-footer__bar">
      <span>© {year} Sikander Bakht</span>
      <span>{person.location}</span>
      <a href="/#intro" class="site-footer__top-link">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--color-line);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
  }
  .site-footer__top {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }
  .site-footer__blurb {
    margin-top: 0.9rem;
    max-width: 34ch;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .site-footer__col h2 {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-bottom: 0.3rem;
  }
  .site-footer__col a {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    width: fit-content;
    transition: color 0.3s;
  }
  .site-footer__col a:hover {
    color: var(--color-ink);
  }
  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    align-items: center;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.8rem;
    color: var(--color-ink-faint);
  }
  .site-footer__top-link {
    color: var(--color-ink-soft);
    transition: color 0.3s;
  }
  .site-footer__top-link:hover {
    color: var(--color-ink);
  }
  @media (min-width: 720px) {
    .site-footer__top {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
    }
    .site-footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

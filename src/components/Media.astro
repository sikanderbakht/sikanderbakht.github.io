---
import { Image } from "astro:assets";
import { isVector } from "../lib/images";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const { src, alt, eager = false, sizes = "(min-width: 1080px) 30vw, (min-width: 640px) 45vw, 90vw", class: className = "" } = Astro.props;
const vector = isVector(src);
---

{
  vector ? (
    <img
      src={src.src}
      alt={alt}
      width={src.width}
      height={src.height}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class={className}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={[320, 480, 720, 1080]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class={className}
      {...(eager ? { fetchpriority: "high" } : {})}
    />
  )
}
